<?xml version="1.0"?>
<robot name="pendulum">

  <!-- Base link -->
  <link name="base">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 0.05"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"/>
    </inertial>
  </link>

  <!-- Pendulum rod -->
  <link name="rod">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.003" iyy="0.003" izz="0.003"/>
    </inertial>
  </link>

  <!-- Heavy box on top -->
  <link name="top_mass">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin xyz="0 0 0.75"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin xyz="0 0 0.75"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"/>
    </inertial>
  </link>

  <!-- Joint: base to rod -->
  <joint name="hinge" type="revolute">
    <parent link="base"/>
    <child link="rod"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="10"/>
  </joint>

  <!-- Joint: rod to top_mass (fixed) -->
  <joint name="top_attachment" type="fixed">
    <parent link="rod"/>
    <child link="top_mass"/>
    <origin xyz="0 0 0.5"/>
  </joint>

</robot>
